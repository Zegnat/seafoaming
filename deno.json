{
  "imports": {
    "@std/encoding": "jsr:@std/encoding@1",
    "@std/toml": "jsr:@std/toml@1",
    "esbuild": "npm:esbuild@0.28.2",
    "sharp": "npm:sharp@0.34.5",
    "thumbhash": "npm:thumbhash@0.1.1"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "serve": "zola serve --output-dir .cache/serve --force",
    "fetch": "deno run --allow-run=yt-dlp --allow-net=i.ytimg.com --allow-read --allow-write=.cache scripts/fetch.ts",
    "whisper": "deno run --allow-read --allow-write=.cache/whisper --allow-env=HOME --allow-run=yt-dlp,ffmpeg,whisper-cli scripts/whisper.ts",
    "generate": "deno run --allow-read --allow-write=content,static/thumbs,static/covers,LICENSES/LicenseRef-YouTubeCreators.txt --allow-env --allow-ffi --allow-sys scripts/generate.ts",
    "test": "deno test --allow-read scripts/",
    "build": "zola build && deno run --allow-read --allow-write=public --allow-env --allow-run scripts/build.ts",
    "import-asmrindex": "deno run --allow-read --allow-write=.cache scripts/import-asmrindex.ts",
    "lookup-asmrindex": "deno run --allow-read --allow-write=.cache --allow-net=127.0.0.1,i.theasmrindex.com scripts/lookup-asmrindex.ts",
    "apple": "deno run --allow-read --allow-write=.cache/apple,community/videos --allow-net=127.0.0.1,itunes.apple.com,is1-ssl.mzstatic.com scripts/apple.ts",
    "spotify": "deno run --allow-read --allow-write=.cache/spotify,community/videos --allow-net=127.0.0.1,open.spotify.com,i.scdn.co scripts/spotify.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "include": [
      "scripts/",
      "static/site.js"
    ]
  },
  "lint": {
    "include": [
      "scripts/",
      "static/site.js"
    ]
  }
}
